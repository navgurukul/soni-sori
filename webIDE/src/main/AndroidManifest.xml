<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:dist="http://schemas.android.com/apk/distribution"
    xmlns:tools="http://schemas.android.com/tools"
    package="org.navgurukul.webide">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- maxSdkVersion=32: Android 13+ uses READ_MEDIA_* instead -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- maxSdkVersion=28: WRITE_EXTERNAL_STORAGE deprecated since Android 10 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <dist:module
        dist:instant="false"
        dist:title="@string/title_webIDE">
        <dist:delivery>
            <dist:on-demand />
        </dist:delivery>
        <dist:fusing dist:include="true" />
    </dist:module>

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:allowBackup">

        <activity
            android:name=".ui.activity.SplashActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:exported="false">
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN" />-->
<!--                <action android:name="android.intent.action.VIEW" />-->
<!--                <category android:name="android.intent.category.LAUNCHER" />-->
<!--            </intent-filter>-->
        </activity>

        <activity
            android:name=".ui.activity.WebIdeHomeActivity"
            android:label="@string/app_name"
            android:exported="false"/>
        <activity
            android:name=".ui.activity.WebActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/app_name"
            android:exported="false"/>
        <activity
            android:name=".ui.activity.ProjectActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="@string/app_name"
            android:parentActivityName=".ui.activity.WebIdeHomeActivity"
            android:windowSoftInputMode="adjustResize|stateHidden"
            tools:ignore="UnusedAttribute"
            android:exported="false">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.activity.WebIdeHomeActivity" />
        </activity>
        <activity android:name=".ui.activity.IntroActivity"
            android:exported="false"/>
        <activity
            android:name=".ui.activity.RemotesActivity"
            android:label="Remotes"
            android:exported="false"/>
        <activity
            android:name=".ui.activity.SettingsActivity"
            android:label="@string/action_settings"
            android:exported="false"/>
        <activity android:name=".ui.activity.AnalyzeActivity"
            android:exported="false"/>
    </application>

</manifest>